<?xml version="1.0" encoding="utf-8"?>
<Package name="com.imengyu.test" version="1">
  <!--
    Package metadata
    Required name: a unique package ID such as com.author.package. Code uses this ID to access the package.
    Required version: an integer used for indexing and compatibility comparisons.
    Required BaseInfo: display metadata.
    Name: display name.
    Author: author name.
    Introduction: package description.
    Logo: image beside PackageDef.xml.
    VersionName: user-visible version; Package.version is the numeric version.
  -->
  <BaseInfo>
    <Name>Test Mod</Name>
    <Author>mengyu</Author>
    <Introduction>A test package</Introduction>
    <!--Package description; Unity RichText is supported.-->
    <Description>
      <![CDATA[This is <color=#f00>a package</color>]]>
    </Description>
    <Link>https://yourwebsite.com</Link> <!--Package homepage URL.-->
    <AuthorLink>https://yourwebsite.com</AuthorLink><!--Author homepage URL.-->
    <DocLink>https://yourwebsite.com</DocLink><!--Package documentation URL.-->

    <VersionName>1.0.DEV</VersionName>
    <!--Package dependencies.-->
    <Dependencies>
      <Package name="core" minVer="1" mustLoad="true"></Package>
      <!--
        Declare dependencies here; the loader resolves their loading order.
        name: dependency package ID.
        minVer: minimum dependency version; omit to allow any version.
        mustLoad: true makes dependency loading failure fatal.
      -->
      <!--
      <Package name="core.scenes.menulevel.ui" minVer="1" mustLoad="true" ></Package>
      -->
    </Dependencies>
  </BaseInfo>
  <!--
    Package compatibility
    MinVersion: minimum supported game core version.
    TargetVersion: optional target game core version for API compatibility handling.
  -->
  <Compatibility>
    <MinVersion>1</MinVersion>
    <TargetVersion>1</TargetVersion>
  </Compatibility>
  <!--
    Package type: Module or Asset.
    Only Module packages may execute code.
  -->
  <Type>Module</Type>
</Package>